# Production environment — copy to .env on the server and fill in real values.
# TLS/HTTPS is expected to terminate at a reverse proxy (nginx/Caddy).

APP_ENV=production

DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/ibra_orders
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING________________________

# Comma-separated or JSON list — only your public frontend origin(s)
CORS_ORIGINS=https://orders.example.com
TRUSTED_HOSTS=orders.example.com,api.orders.example.com

UPLOAD_DIR=/var/lib/ibra/uploads
TELEGRAM_BOT_TOKEN=

# PostgreSQL (docker-compose.prod.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ibra_orders
