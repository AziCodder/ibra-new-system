# Production environment template — copy to .env and fill in real values
# NEVER commit the real .env to version control.

# Set to "production" to enable all security checks (SESSION_SECRET length,
# CORS whitelist, TRUSTED_HOSTS, cookie Secure flag, docs disabled).
APP_ENV=production

# asyncpg connection URL to the production PostgreSQL instance.
# Replace host, port, user, password, and database name.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/ibra_orders

# Random secret used to sign session cookies.
# Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS

# Directory where uploaded files are stored on the server.
UPLOAD_DIR=/var/app/uploads

# Telegram bot token for order-status notifications.
# Obtain from @BotFather. Leave empty to disable notifications.
TELEGRAM_BOT_TOKEN=

# Public address of the app — links inside Telegram notifications are built from
# it, so a wrong value sends the recipient nowhere. No trailing slash.
# Example: https://orders.example.com
PUBLIC_BASE_URL=https://YOUR_FRONTEND_DOMAIN

# Comma-separated list of allowed frontend origins (no trailing slash).
# Wildcard (*) is blocked in production.
# Example: https://orders.example.com
CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN

# Comma-separated list of allowed Host header values.
# Should match the domain(s) your reverse proxy forwards requests to.
# Example: orders.example.com,api.orders.example.com
TRUSTED_HOSTS=YOUR_DOMAIN

# Cookie SameSite policy. "lax" is the default and works for most setups.
# Use "strict" if the frontend and backend share the same domain.
COOKIE_SAMESITE=lax

# ─────────────────────────────────────────── Хранилище вложений (файлы)
# "local" — папка на диске (только для разработки), "s3" — два независимых
# S3: основной (HostKey) и зеркало (Storj). Файл считается сохранённым,
# когда его принял ОСНОВНОЙ бакет; зеркало дозаливается фоновой задачей,
# если в момент загрузки было недоступно.
STORAGE_BACKEND=local

# Общий префикс ключей внутри бакетов (папка верхнего уровня).
S3_PREFIX=files/

# Основной бакет — обязателен при STORAGE_BACKEND=s3.
S3_PRIMARY_LABEL=HostKey S3
S3_PRIMARY_ENDPOINT=https://YOUR-S3-ENDPOINT
S3_PRIMARY_REGION=
S3_PRIMARY_BUCKET=ibra-files
S3_PRIMARY_ACCESS_KEY=
S3_PRIMARY_SECRET_KEY=

# Зеркало — второй провайдер. Без него хранилище работает, но без
# отказоустойчивости: авария провайдера оставит систему без вложений.
S3_MIRROR_LABEL=Storj
S3_MIRROR_ENDPOINT=https://gateway.storjshare.io
S3_MIRROR_REGION=
S3_MIRROR_BUCKET=ibra-files
S3_MIRROR_ACCESS_KEY=
S3_MIRROR_SECRET_KEY=

# ─────────────────────────────────────────────────────────── Кластер из двух серверов
# Один и тот же файл на обоих серверах, отличаются только эти три строки.
# Кто главный, а кто резерв — конфигом НЕ задаётся: это знает сама база
# (pg_is_in_recovery). Иначе после переключения конфиг врал бы о роли.
NODE_NAME=A
NODE_PUBLIC_IP=                       # публичный IP ЭТОГО сервера — на него переводится домен
PEER_URL=http://10.8.0.2/api/cluster/ping   # сосед по адресу внутри туннеля

# Автоперехват. Включать ТОЛЬКО после того, как репликация настроена и
# проверена учениями: до этого пусть работает в режиме наблюдения.
FAILOVER_ENABLED=false
PEER_FAILURES_BEFORE_FAILOVER=4       # 4 проверки по 30 c ≈ 2 минуты молчания

# Синхронная репликация: транзакция подтверждается после записи на второй
# сервер. Если резерв пропал дольше указанного времени, режим автоматически
# опускается до асинхронного — иначе мёртвый резерв заморозил бы всю запись.
SYNC_REPLICATION=true
SYNC_STANDBY_NAME=standby
SYNC_DEGRADE_AFTER_SECONDS=30

# Переключение домена при аварии: cloudflare | regru | none.
# none — только запись в журнал и уведомление, переключаете руками.
DNS_PROVIDER=none
DNS_ZONE=cargo-ibragim.ru
DNS_RECORD=flow
DNS_TTL=60
REGRU_LOGIN=
REGRU_PASSWORD=                       # пароль для API reg.ru, не от личного кабинета
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Куда слать тревоги кластера (chat_id в Telegram). Пусто — только в логи,
# то есть о переключении никто не узнает вовремя.
ALERT_CHAT_ID=
