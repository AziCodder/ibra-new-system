# Environment: development | production
APP_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ibra_orders
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ibra_orders

# Session (production: min 32 random chars, see .env.production.example)
SESSION_SECRET=change-me-to-random-string

# CORS — comma-separated origins or JSON list
CORS_ORIGINS=http://localhost:5173

# Host header allow-list (required in production)
TRUSTED_HOSTS=

# File storage
UPLOAD_DIR=./uploads

# Telegram bot
TELEGRAM_BOT_TOKEN=
